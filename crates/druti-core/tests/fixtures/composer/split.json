{
  "format": 1,
  "description": "ime-composer spec: Commit and pending split; Keys the engine does not map",
  "cases": [
    {"name": "consonant stays pending", "steps": [{"key": "k", "expect": {"commit": "", "pending": "ক", "handled": true}}]},
    {"name": "aspiration rewrites only the pending text", "steps": [{"key": "k"}, {"key": "h", "expect": {"commit": "", "pending": "খ", "handled": true}}]},
    {"name": "kar stays in the pending word", "steps": [{"key": "k"}, {"key": "h"}, {"key": "u", "expect": {"commit": "", "pending": "খু", "handled": true}}], "committed": ""},
    {"name": "space commits the word", "steps": [{"key": "k"}, {"key": "h"}, {"key": "u"}, {"key": "b", "expect": {"commit": "", "pending": "খুব", "handled": true}}, {"key": " ", "expect": {"commit": "খুব ", "pending": "", "handled": true}}], "committed": "খুব "},
    {"name": "vowel sign change stays pending", "steps": [{"key": "k"}, {"key": "O", "expect": {"commit": "", "pending": "কো", "handled": true}}, {"key": "i", "expect": {"commit": "", "pending": "কৈ", "handled": true}}, {"flush": 1, "expect": {"commit": "কৈ", "pending": "", "handled": true}}], "committed": "কৈ"},
    {"name": "question mark after a word", "steps": [{"key": "k"}, {"key": "i"}, {"key": "?", "expect": {"commit": "কি?", "pending": "", "handled": true}}], "committed": "কি?"},
    {"name": "symbol while a cluster is pending", "steps": [{"key": "k", "expect": {"commit": "", "pending": "ক", "handled": true}}, {"key": "(", "expect": {"commit": "ক(", "pending": "", "handled": true}}, {"key": "h", "expect": {"commit": "", "pending": "হ", "handled": true}}]},
    {"name": "digit commits the word", "steps": [{"key": "k"}, {"key": "1", "expect": {"commit": "ক১", "pending": "", "handled": true}}], "committed": "ক১"},
    {"name": "Enter flushes and is not handled", "steps": [{"key": "k"}, {"key": "Enter", "expect": {"commit": "ক", "pending": "", "handled": false}}], "committed": "ক"},
    {"name": "unknown key name keeps pending text", "steps": [{"key": "k"}, {"key": "Shift", "expect": {"commit": "", "pending": "ক", "handled": false}}]}
  ]
}
