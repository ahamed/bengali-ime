{
  "format": 1,
  "description": "ime-composer spec: Holding a trailing hyphen or dari; Committed text is never changed",
  "cases": [
    {"name": "double hyphen becomes an em dash", "steps": [{"key": "-", "expect": {"commit": "", "pending": "-", "handled": true}}, {"key": "-", "expect": {"commit": "—", "pending": "", "handled": true}}], "committed": "—"},
    {"name": "single hyphen followed by a letter", "steps": [{"key": "-"}, {"key": "k", "expect": {"commit": "-", "pending": "ক", "handled": true}}]},
    {"name": "ellipsis after a dari", "steps": [{"key": "a", "expect": {"commit": "", "pending": "আ", "handled": true}}, {"key": ".", "expect": {"commit": "আ", "pending": "।", "handled": true}}, {"key": ".", "expect": {"commit": "..", "pending": "", "handled": true}}, {"key": ".", "expect": {"commit": ".", "pending": "", "handled": true}}], "committed": "আ..."},
    {"name": "dari then space", "steps": [{"key": "a"}, {"key": "."}, {"key": " ", "expect": {"commit": "। ", "pending": "", "handled": true}}], "committed": "আ। "},
    {"name": "decimal point is not held", "steps": [{"key": "1", "expect": {"commit": "১", "pending": "", "handled": true}}, {"key": ".", "expect": {"commit": ".", "pending": "", "handled": true}}, {"key": "5", "expect": {"commit": "৫", "pending": "", "handled": true}}], "committed": "১.৫"},
    {"name": "hyphen already in the document is not rewritten", "document": "ক-", "steps": [{"reset": 1}, {"key": "-", "ctx": "ক-", "expect": {"commit": "", "pending": "-", "handled": true}}], "committed": "ক-"},
    {"name": "dari already in the document is not rewritten", "document": "ক।", "steps": [{"reset": 1}, {"key": ".", "ctx": "ক।", "expect": {"commit": "", "pending": "।", "handled": true}}], "committed": "ক।"},
    {"name": "chandrabindu already in the document is not rewritten", "document": "কঁ", "steps": [{"reset": 1}, {"key": "a", "ctx": "কঁ", "expect": {"commit": "", "pending": "আ", "handled": true}}], "committed": "কঁ"}
  ]
}
